        <div class="order-summary">
          <div><span>Est. notional</span><strong>${formatUsd((Number(appState.order.quantity || 0) || 0) * getMarketBySymbol(appState.selectedSymbol || 'BTC').price)}</strong></div>
          <div><span>Cash available</span><strong>${formatUsd(appState.account.cashCents / 100)}</strong></div>
          <div><span>Execution type</span><strong>Practice market</strong></div>
