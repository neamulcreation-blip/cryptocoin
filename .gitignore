import { format } from 'util';

const appState = {
  view: 'overview',
  selectedSymbol: 'BTC',
  marketData: [],
  order: { side: 'buy', symbol: 'BTC', quantity: '0.01' },
  account: {
    userId: 'guest',
    cashCents: 0,
    watchlist: ['BTC', 'ETH', 'SOL'],
    holdings: [],
    orders: []
  },
};

const fallbackMarkets = [
  { symbol: 'BTC', name: 'Bitcoin', price: 64230.12, change: 1.64, spark: [40, 44, 46, 45, 49, 52, 60] },
  { symbol: 'ETH', name: 'Ethereum', price: 3481.23, change: -0.73, spark: [50, 52, 48, 47, 49, 51, 55] },
  { symbol: 'SOL', name: 'Solana', price: 147.38, change: 2.21, spark: [30, 34, 32, 36, 40, 38, 42] },
  { symbol: 'BNB', name: 'BNB', price: 581.77, change: 0.85, spark: [25, 28, 27, 31, 35, 33, 37] },
  { symbol: 'XRP', name: 'XRP', price: 0.59, change: -0.4, spark: [42, 40, 44, 43, 41, 45, 46] },
  { symbol: 'ADA', name: 'Cardano', price: 0.62, change: 1.2, spark: [35, 38, 36, 39, 42, 41, 43] },
  { symbol: 'AVAX', name: 'Avalanche', price: 34.8, change: -2.1, spark: [33, 37, 36, 35, 39, 38, 41] },
  { symbol: 'DOGE', name: 'Dogecoin', price: 0.17, change: 2.7, spark: [50, 48, 52, 57, 59, 61, 64] },
];

const formatUsd = (value) => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 2 }).format(value || 0);
const formatNumber = (value) => new Intl.NumberFormat('en-US', { maximumFractionDigits: value >= 1 ? 2 : 4 }).format(value || 0);
const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));

function setStatus(message) {
  const el = document.getElementById('market-status');
  if (el) el.textContent = message;
}

function setPageTitle(label) {
  const breadcrumb = document.getElementById('breadcrumb');
  const title = document.getElementById('page-title');
  const description = document.getElementById('page-description');
  if (breadcrumb) breadcrumb.textContent = label;
  const map = {
    overview: ['Your market. In focus.', 'A fresh perspective on your portfolio and the crypto markets.'],
    markets: ['Markets', 'Track the market where opportunity and reference data meet.'],
    trade: ['Trade', 'Practice spot orders with live reference prices.'],
    wallet: ['My wallet', 'Track balances, holdings, and portfolio value.'],
    history: ['Order history', 'A complete record of your recent practice trades.'],
    watchlist: ['Watchlist', 'Your saved names and key movers.'],
    settings: ['Account settings', 'Manage your profile and secure trading preferences.'],
  };
  const data = map[label] || map.overview;
  if (title) title.innerHTML = `${escapeHtml(data[0])}<span>.</span>`;
  if (description) description.textContent = data[1];
}

function renderSparkline(points, color = '#ed9876') {
  if (!Array.isArray(points) || points.length < 2) return '';
  const width = 64;
  const height = 25;
  const mins = Math.min(...points);
  const maxs = Math.max(...points);
  const range = maxs - mins || 1;
  const path = points.map((point, index) => {
    const x = (index / (points.length - 1)) * width;
    const y = height - ((point - mins) / range) * height;
    return `${index === 0 ? 'M' : 'L'}${x} ${y}`;
  }).join(' ');
  return `<svg class="mini-spark" viewBox="0 0 ${width} ${height}" preserveAspectRatio="none"><path d="${path}" fill="none" stroke="${color}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>`;
}

function getMarketBySymbol(symbol) {
  return (appState.marketData.find((coin) => coin.symbol.toUpperCase() === symbol.toUpperCase()) || fallbackMarkets.find((coin) => coin.symbol.toUpperCase() === symbol.toUpperCase()) || {
    symbol,
    name: symbol,
    price: 0,
    change: 0,
    spark: [0, 0, 0],
  });
}

function buildOverview() {
  const main = document.getElementById('page-content');
  const topCoins = appState.marketData.slice(0, 3);
  const value = appState.account.holdings.reduce((sum, holding) => {
    const market = getMarketBySymbol(holding.symbol);
    return sum + Number(holding.quantity || 0) * Number(market.price || 0);
  }, 0) + appState.account.cashCents / 100;

  main.innerHTML = `
    <section class="summary-grid">
      <article class="balance-card">
        <div class="balance-label"><span data-icon="wallet"></span> Practice balance</div>
        <div class="balance-tag">LIVE</div>
        <div class="balance-value">${formatUsd(appState.account.cashCents / 100)}<small>USD</small></div>
        <div class="balance-meta"><span class="positive"><span data-icon="arrow-up"></span> +2.68%</span><span>Portfolio value ${formatUsd(value)}</span></div>
        <div class="balance-bottom"><span>Secure practice account</span><button data-action="account">View account</button></div>
      </article>
      <aside class="market-highlights">
        <div class="section-top">
          <h2>Market highlights</h2>
          <span class="live-label"><i></i> Live reference data</span>
        </div>
        <div class="highlight-grid">
          ${topCoins.map((coin) => `
            <div class="highlight">
              <div class="coin-heading"><span class="coin-icon ${coin.symbol.toLowerCase()}">${coin.symbol.slice(0, 1)}</span><span>${coin.symbol}<small>${coin.name}</small></span></div>
              <div class="highlight-price">${formatUsd(coin.price)}</div>
              <div class="highlight-bottom">
                <span class="change ${coin.change < 0 ? 'negative' : ''}">${coin.change > 0 ? '+' : ''}${coin.change.toFixed(2)}%</span>
                ${renderSparkline(coin.spark, coin.change >= 0 ? '#319d7c' : '#d76469')}
              </div>
            </div>
          `).join('')}
        </div>
      </aside>
    </section>
    <section class="work-grid">
      <article class="panel chart-panel">
        <div class="chart-top">
          <div class="selected-coin">
            <span class="coin-icon btc">₿</span>
            <div><strong>Bitcoin</strong><small>BTC-USD · Reference price</small></div>
          </div>
          <div class="chart-selector"><span data-icon="chevron-down"></span> 1D</div>
        </div>
        <div class="chart-price-row">
          <div>
            <div class="chart-price">${formatUsd(getMarketBySymbol('BTC').price)}<span class="change ${getMarketBySymbol('BTC').change < 0 ? 'negative' : ''}">${getMarketBySymbol('BTC').change > 0 ? '+' : ''}${getMarketBySymbol('BTC').change.toFixed(2)}%</span></div>
            <div class="chart-subtitle">CoinGecko snapshot · not a live execution quote</div>
          </div>
          <div class="period-tabs">
            <button class="active" data-period="1D">1D</button>
            <button data-period="1W">1W</button>
            <button data-period="1M">1M</button>
          </div>
        </div>
        <div class="chart-area">
          <svg class="main-chart" viewBox="0 0 1000 205" preserveAspectRatio="none" aria-label="Bitcoin chart">
            <g>
              <path class="chart-grid" d="M0 40 H1000"></path>
              <path class="chart-grid" d="M0 90 H1000"></path>
              <path class="chart-grid" d="M0 140 H1000"></path>
              <path class="chart-grid" d="M0 190 H1000"></path>
            </g>
            <path class="chart-fill" fill="url(#chartFill)" d="M0 150 C100 120, 180 120, 250 100 S450 80, 520 100 S760 70, 1000 90 L1000 205 L0 205 Z"></path>
            <path class="chart-line" d="M0 150 C100 120, 180 120, 250 100 S450 80, 520 100 S760 70, 1000 90"></path>
            <defs>
              <linearGradient id="chartFill" x1="0" x2="0" y1="0" y2="1">
                <stop offset="0%" stop-color="#eeab8a" stop-opacity="0.45"></stop>
                <stop offset="100%" stop-color="#eeab8a" stop-opacity="0"></stop>
              </linearGradient>
            </defs>
          </svg>
          <div class="chart-tooltip">${formatUsd(getMarketBySymbol('BTC').price)}</div>
        </div>
        <div class="chart-source"><span>Reference source: CoinGecko</span><span>Updated just now</span></div>
      </article>
      <aside class="trade-panel panel">
        <div class="panel-heading"><h2>Practice trade</h2><span class="practice-pill">SIMULATED</span></div>
        <div class="trade-tabs">
          <button class="active" data-side="buy">Buy</button>
          <button data-side="sell">Sell</button>
        </div>
